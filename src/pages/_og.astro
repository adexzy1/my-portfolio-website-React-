---
/**
 * Social card source. Rendered once with headless Chrome at 1200×630 and saved to public/og.png.
 * Rename to _og.astro after capturing to drop the route from the build.
 */
import '@fontsource-variable/manrope';
import { profile } from '../data/profile';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>OG card</title>
    <style>
      html,
      body {
        margin: 0;
        width: 1200px;
        height: 630px;
        background: #fafaf8;
        color: #151817;
        font-family: 'Manrope Variable', system-ui, sans-serif;
        overflow: hidden;
      }
      .card {
        box-sizing: border-box;
        width: 1200px;
        height: 630px;
        padding: 72px 80px;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
      }
      .name {
        font-size: 26px;
        font-weight: 500;
      }
      h1 {
        margin: 0;
        font-size: 96px;
        line-height: 0.98;
        letter-spacing: -0.045em;
        font-weight: 600;
        max-width: 1000px;
      }
      h1 span {
        color: #cc472d;
      }
      .foot {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        font-size: 20px;
        color: #4f5552;
      }
    </style>
  </head>
  <body>
    <div class="card">
      <p class="name">{profile.name}</p>
      <h1>{profile.headline[0]}<span>{profile.headline[1]}</span></h1>
      <div class="foot">
        <div>Full-Stack Engineer · React, TypeScript, Laravel, Go, SwiftUI</div>
        <div>johns-portfolio-bice.vercel.app</div>
      </div>
    </div>
  </body>
</html>
