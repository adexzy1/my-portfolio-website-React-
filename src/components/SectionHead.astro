---
interface Props {
  index: string;
  label: string;
  title: string;
  em?: string;
  note?: string;
}
const { index, label, title, em, note } = Astro.props;
---

<div>
  <p class="eyebrow"><span class="text-accent">{index}</span> — {label}</p>
  <div class="mt-4 flex flex-col gap-5 md:flex-row md:items-end md:justify-between">
    <h2 class="max-w-3xl text-balance text-3xl font-medium tracking-[-0.03em] text-ink md:text-5xl md:leading-[1.04]">
      {title}{em && ' '}{em && <em class="serif-italic text-accent">{em}</em>}
    </h2>
    {note && <p class="max-w-sm text-sm leading-relaxed text-ink-2 md:text-right">{note}</p>}
  </div>
</div>
