---
import { profile } from '../data/profile';
---

<section id="contact" class="section border-t border-line">
  <div class="container-x grid gap-10 md:grid-cols-12 md:items-end">
    <div class="md:col-span-8">
      <p class="eyebrow">Say hello</p>
      <h2 class="mt-4 max-w-3xl text-balance text-[2.25rem] font-semibold leading-[1.02] tracking-[-0.035em] text-ink md:text-[3.5rem]">
        Let's build something that <span class="text-accent">moves money safely.</span>
      </h2>
      <p class="mt-5 max-w-lg text-[15px] leading-relaxed text-ink-2 md:text-base">{profile.availability} Replies within a day on weekdays.</p>
      <div class="mt-8 flex flex-wrap items-center gap-4">
        <a href={`mailto:${profile.email}`} class="btn btn-primary">Email me</a>
        <button type="button" class="btn btn-ghost" data-copy={profile.email}>Copy address</button>
      </div>
    </div>
    <ul class="flex flex-col gap-3 md:col-span-4 md:items-end">
      {
        profile.socials.map((s) => (
          <li>
            <a class="text-link" href={s.href} target="_blank" rel="noopener noreferrer">
              {s.label}
              <span class="arrow">
                <svg class="arrow-ne" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path d="M7 17 17 7m0 0H8m9 0v9" />
                </svg>
              </span>
            </a>
          </li>
        ))
      }
      <li>
        <a class="text-link" href={profile.resume} target="_blank" rel="noopener">
          Resume
          <span class="arrow">
            <svg class="arrow-down" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M12 4v16m0 0-6-6m6 6 6-6" />
            </svg>
          </span>
        </a>
      </li>
    </ul>
  </div>
</section>
