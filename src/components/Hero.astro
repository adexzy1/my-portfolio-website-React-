---
import { profile } from '../data/profile';
---

<section id="top" class="relative overflow-hidden pt-36 md:pt-44">
  <div class="hero-arcs" aria-hidden="true"></div>
  <div class="container-x relative">
    <p class="text-[22px] font-medium tracking-[-0.01em] text-ink md:text-[25px]">{profile.name}</p>

    <h1 class="mt-7 max-w-6xl text-balance text-[clamp(3.25rem,7.1vw,6.75rem)] font-semibold leading-[1.04] tracking-[-0.045em] text-ink">
      {profile.headline[0]}<span class="text-accent">{profile.headline[1]}</span>
    </h1>

    <div class="mt-10 grid gap-8 md:mt-12 md:grid-cols-12 md:items-center md:gap-10">
      <div class="md:col-span-7">
        <p class="max-w-2xl text-lg leading-relaxed text-ink-2 md:text-[1.375rem] md:leading-[1.5]">
          {profile.lead.before}<strong class="font-semibold text-ink">{profile.lead.strong}</strong>{profile.lead.after}<br />
          {profile.lead.line}
        </p>
        <p class="mt-5 text-[15px] text-ink-3">{profile.subline}</p>
      </div>
      <div class="md:col-span-5 md:flex md:justify-end">
        <a href="#work" class="btn btn-primary">
          Explore my work
          <svg class="arrow-down" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
            <path d="M12 4v16m0 0-6-6m6 6 6-6" />
          </svg>
        </a>
      </div>
    </div>

    <p class="mt-10 flex items-center justify-end gap-3 text-xs text-ink-3 md:mt-14">
      <span class="h-px w-8 bg-line-2"></span>
      <span class="h-1 w-1 rounded-full bg-accent"></span>
      Scroll to explore
    </p>
  </div>
</section>
