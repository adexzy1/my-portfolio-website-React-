---
import { profile } from '../data/profile';

interface Props {
  showApps?: boolean;
}
const { showApps = false } = Astro.props;

const links = [
  { href: '#work', label: 'Work' },
  ...(showApps ? [{ href: '#apps', label: 'Apps' }] : []),
  { href: '#about', label: 'About' },
];
---

<header class="site-header fixed inset-x-0 top-0 z-50" data-header>
  <div class="container-x flex h-20 items-center justify-between gap-6">
    <a href="#top" class="text-[1.75rem] font-bold leading-none tracking-[-0.04em] text-ink" aria-label="Back to top">
      {profile.initials}<span class="text-accent">.</span>
    </a>

    <nav class="hidden items-center gap-8 md:flex" aria-label="Primary">
      {links.map((l, i) => <a href={l.href} class:list={['nav-link', { 'is-active': i === 0 }]}>{l.label}</a>)}
    </nav>

    <div class="flex items-center gap-7">
      <a href={profile.resume} class="text-link hidden md:inline-flex" target="_blank" rel="noopener">
        Resume
        <svg class="arrow-down" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
          <path d="M12 4v16m0 0-6-6m6 6 6-6" />
        </svg>
      </a>
      <a href="#contact" class="text-link hidden md:inline-flex">
        Say hello
        <svg class="arrow-ne" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
          <path d="M7 17 17 7m0 0H8m9 0v9" />
        </svg>
      </a>
      <button
        type="button"
        class="flex h-10 w-10 items-center justify-center rounded-full border border-line-2 text-ink md:hidden"
        data-nav-toggle
        aria-controls="mobile-nav"
        aria-expanded="false"
        aria-label="Toggle menu"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
          <path d="M3 7h18M3 12h18M3 17h18" />
        </svg>
      </button>
    </div>
  </div>
</header>

<nav
  id="mobile-nav"
  class="fixed inset-0 z-40 hidden flex-col bg-paper px-5 pb-10 pt-24 md:hidden"
  data-mobile-nav
  aria-label="Mobile"
>
  <ul class="flex flex-col divide-y divide-line border-y border-line">
    {
      [...links, { href: '#contact', label: 'Say hello' }].map((l) => (
        <li>
          <a href={l.href} class="flex items-center justify-between py-5 text-2xl font-semibold tracking-tight text-ink">
            {l.label}
          </a>
        </li>
      ))
    }
  </ul>
  <div class="mt-8 flex flex-col gap-3">
    <a href={`mailto:${profile.email}`} class="btn btn-primary justify-center">Email me</a>
    <a href={profile.resume} class="btn btn-ghost justify-center" target="_blank" rel="noopener">Resume (PDF)</a>
  </div>
</nav>
